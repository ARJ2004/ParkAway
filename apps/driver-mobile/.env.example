# Copy to .env (gitignored). Expo inlines EXPO_PUBLIC_* vars at build time.
#
# The API server isn't reachable at "localhost" from a physical device or
# most emulators — that always means the device itself, not your dev machine.
# Set this to your dev machine's LAN IP (e.g. run `ipconfig` on Windows and
# use the IPv4 address), keeping the API's port (3000). Android emulator only
# (not physical devices, not iOS simulator) can alternatively use
# http://10.0.2.2:3000, which Android maps back to the host machine.
EXPO_PUBLIC_API_URL=http://192.168.1.100:3000
