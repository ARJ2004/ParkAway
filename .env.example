# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

NODE_ENV=development

# --- Postgres (docker-compose local dev) ---
# Host port is 55432 by default, not 5432 — see docker-compose.yml comment
# (avoids silently colliding with any native Postgres already on this machine).
POSTGRES_USER=parkaway
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=parkaway
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgres://parkaway:changeme-strong-password@localhost:55432/parkaway

# --- Redis (docker-compose local dev) ---
REDIS_PASSWORD=changeme-strong-password
REDIS_URL=redis://:changeme-strong-password@localhost:6379

# --- API server ---
PORT=3000
HOST=0.0.0.0

# --- Auth / sessions ---
# openssl rand -hex 32
JWT_ACCESS_SECRET=changeme-access-secret-min-32-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_VERSION_CACHE_TTL_SECONDS=60

# --- OTP / SMS provider (mock-only until a real provider is chosen — tech-stack.md §8, §12) ---
SMS_PROVIDER=mock
DEV_OTP_BYPASS_CODE=123456
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_PER_HOUR=5
OTP_REQUEST_LIMIT_PER_IP_PER_HOUR=20

# --- Admin auth ---
ADMIN_LOGIN_RATE_LIMIT_PER_ACCOUNT_PER_15MIN=5
ADMIN_LOGIN_RATE_LIMIT_PER_IP_PER_15MIN=20

# --- First-admin bootstrap (scripts/seedAdmin.ts) ---
SEED_ADMIN_EMAIL=admin@parkaway.local
SEED_ADMIN_PASSWORD=changeme-seed-admin-password
