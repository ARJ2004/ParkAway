# Copy to .env and fill in real values. .env is gitignored — never commit real secrets.

NODE_ENV=development

# --- Postgres (docker-compose local dev) ---
# Host port is 55432 by default, not 5432 — see docker-compose.yml comment
# (avoids silently colliding with any native Postgres already on this machine).
POSTGRES_USER=parkaway
POSTGRES_PASSWORD=changeme-strong-password
POSTGRES_DB=parkaway
POSTGRES_HOST_PORT=55432
DATABASE_URL=postgres://parkaway:changeme-strong-password@localhost:55432/parkaway

# --- Redis (docker-compose local dev) ---
REDIS_PASSWORD=changeme-strong-password
REDIS_URL=redis://:changeme-strong-password@localhost:6379

# --- API server ---
PORT=3000
HOST=0.0.0.0

# --- Auth / sessions ---
# openssl rand -hex 32
JWT_ACCESS_SECRET=changeme-access-secret-min-32-bytes
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_SECONDS=2592000
SESSION_VERSION_CACHE_TTL_SECONDS=60

# --- OTP / SMS provider (mock-only until a real provider is chosen — tech-stack.md §8, §12) ---
SMS_PROVIDER=mock
DEV_OTP_BYPASS_CODE=123456
OTP_LENGTH=6
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=5
OTP_REQUEST_LIMIT_PER_PHONE_PER_HOUR=5
OTP_REQUEST_LIMIT_PER_IP_PER_HOUR=20

# --- Admin auth ---
ADMIN_LOGIN_RATE_LIMIT_PER_ACCOUNT_PER_15MIN=5
ADMIN_LOGIN_RATE_LIMIT_PER_IP_PER_15MIN=20

# --- First-admin bootstrap (scripts/seedAdmin.ts) ---
SEED_ADMIN_EMAIL=admin@parkaway.local
SEED_ADMIN_PASSWORD=changeme-seed-admin-password

# --- Storage provider (mock-only until a real provider is chosen — tech-stack.md §8, §12) ---
STORAGE_PROVIDER=mock
STORAGE_MOCK_DIR=.mock-storage
STORAGE_MOCK_BASE_URL=http://localhost:3000/mock-storage
# Required only when STORAGE_PROVIDER=s3:
# S3_BUCKET_PUBLIC=parkaway-listing-photos
# S3_BUCKET_PRIVATE=parkaway-kyc-documents
# S3_REGION=ap-south-1
PRESIGNED_UPLOAD_TTL_SECONDS=300
PRESIGNED_DOWNLOAD_TTL_SECONDS=300

# --- Maps provider (mock-only until Mapbox is provisioned — tech-stack.md §12) ---
MAPS_PROVIDER=mock
# Required only when MAPS_PROVIDER=mapbox. Server-side secret token — never
# ship this to a browser/app bundle; the client needs its own public token.
# MAPBOX_TOKEN=

# --- BullMQ (reuses REDIS_URL above) ---
BULLMQ_PREFIX=parkaway

# --- Payout encryption (05-sprint-2-detailed-plan.md §2.3, Nikhil §9) ---
# openssl rand -hex 32 — NEVER a real value here, never checked in, never in
# anything pg_dump emits, distinct per environment. Losing this key means
# losing every stored payout account number, irreversibly.
PAYOUT_ENCRYPTION_KEY=
PAYOUT_KEY_VERSION=1
